<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Model downloads (one-time, per language) go over the network; translation itself is on-device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To tell a model download waiting for Wi-Fi from one under way (data/WifiConnection.kt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Other apps' text actions, for the selection menu on the text and its translation. Since
      Android 11 an app sees only the activities it declares it looks for, and the menu showed
      Targmani itself and the system's Read aloud, not a flashcard app to keep the word in.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".TargmaniApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:allowBackup="true"
        android:theme="@style/Theme.Targmani">

        <!--
          singleTop, so text picked out or shared while Targmani is already open reaches
          onNewIntent. Without it, a share started as a new task (from a notification, a widget, a
          service) found Targmani's task, brought it forward and dropped the text, and the earlier
          text stayed in the box.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Targmani" in the menu over text selected in any app, and in the share sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Preload the ML Kit translate model dependencies so first use is quicker. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="translate" />
    </application>

</manifest>
